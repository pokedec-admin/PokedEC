# Configuration Template - DO NOT COMMIT
# Copy this file to .env.local or .env.synology and fill in your values

# ============================================
# NAS / SYNOLOGY CONFIGURATION
# ============================================
NAS_USER=YOUR_USERNAME_HERE
NAS_IP=YOUR_NAS_IP_HERE
NAS_PORT=YOUR_SSH_PORT_HERE
NAS_PATH=/volume1/docker/pokedec-prod

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL credentials
DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
DB_NAME=postgres
DB_HOST=db
DB_PORT=5432

# Production database (for migration scripts)
PROD_DB_HOST=YOUR_PROD_DB_HOST_HERE
PROD_DB_PORT=5433

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# JWT Secret for authentication
JWT_SECRET=YOUR_STRONG_SECRET_KEY_HERE

# Node environment (development/production)
NODE_ENV=development

# Backend API port
PORT=3000

# ============================================
# DOCKER PORTS
# ============================================
# Frontend HTTP port
FRONTEND_HTTP_PORT=8081

# Frontend HTTPS port (if applicable)
FRONTEND_HTTPS_PORT=443

# Database external port
DB_EXTERNAL_PORT=5434

# Nginx port
NGINX_PORT=80
NGINX_HTTPS_PORT=443

# ============================================
# EMAIL SERVICE CONFIGURATION
# ============================================
# SMTP Configuration for email verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-email@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx  # App Password (sans espaces)
SMTP_FROM=votre-email@gmail.com
SMTP_FROM_NAME=PokedEC - Communauté Pokémon GO

# ============================================
# DEFAULT USER CREDENTIALS (for imports)
# ============================================
# Admin_YOUR_DOMAIN user (used in import scripts)
DEFAULT_USER_EMAIL=admin@YOUR_DOMAIN.com
DEFAULT_USER_PASSWORD=YOUR_DEFAULT_PASSWORD_HERE

# ============================================
# EMAIL SERVICE CONFIGURATION
# ============================================
# Required for email verification on signup
# See EMAIL_SETUP.md for detailed configuration instructions

# SMTP Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP Authentication (Gmail App Password recommended)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Email Sender Information
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=PokedEC - Communauté Pokémon GO
