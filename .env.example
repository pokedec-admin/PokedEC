# Configuration Template - DO NOT COMMIT
# Copy this file to .env (git-ignored) and fill in your actual values
# NEVER commit .env file with real secrets — it is in .gitignore

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Full database connection string (PostgreSQL/Supabase)
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/postgres

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Supabase project URL (available in Settings → API)
SUPABASE_URL=https://xxxx.supabase.co

# Supabase Service Role Key (for backend only - keep private!)
# Get from: Settings → API Keys → service_role
# IMPORTANT: Do NOT expose this in frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Anon Key (for frontend - used in public clients)
# Get from: Settings → API Keys → anon
SUPABASE_ANON_KEY=sb_publishable_xxxx...

# ============================================
# AUTHENTICATION
# ============================================
# JWT Secret for token signing (backend only)
# Generate: Use a strong random string (e.g., openssl rand -base64 32)
JWT_SECRET=your_strong_random_key_here_min_32_chars

# ============================================
# DEPLOYMENT & ENVIRONMENT
# ============================================
# Node environment
NODE_ENV=production

# Frontend URL (where frontend is deployed)
FRONTEND_URL=https://www.pokedec.ch

# TLS configuration (set to 0 for self-signed certs, omit for production)
NODE_TLS_REJECT_UNAUTHORIZED=0

# ============================================
# APPLICATION PORTS
# ============================================
# Backend API port
PORT=3000

# ============================================
# NAS / SYNOLOGY CONFIGURATION (Optional)
# ============================================
NAS_USER=YOUR_USERNAME_HERE
NAS_IP=YOUR_NAS_IP_HERE
NAS_PORT=YOUR_SSH_PORT_HERE
NAS_PATH=/volume1/docker/pokedec-prod

# ============================================
# DOCKER PORTS (for local development)
# ============================================
FRONTEND_HTTP_PORT=8081
FRONTEND_HTTPS_PORT=443
DB_EXTERNAL_PORT=5434
NGINX_PORT=80
NGINX_HTTPS_PORT=443

# ============================================
# EMAIL SERVICE CONFIGURATION
# ============================================
# SMTP Configuration for email verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-email@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx  # App Password (sans espaces)
SMTP_FROM=votre-email@gmail.com
SMTP_FROM_NAME=PokedEC - Communauté Pokémon GO

# ============================================
# DEFAULT USER CREDENTIALS (for imports)
# ============================================
# Admin_YOUR_DOMAIN user (used in import scripts)
DEFAULT_USER_EMAIL=admin@YOUR_DOMAIN.com
DEFAULT_USER_PASSWORD=YOUR_DEFAULT_PASSWORD_HERE

# ============================================
# EMAIL SERVICE CONFIGURATION
# ============================================
# Required for email verification on signup
# See EMAIL_SETUP.md for detailed configuration instructions

# SMTP Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP Authentication (Gmail App Password recommended)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Email Sender Information
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=PokedEC - Communauté Pokémon GO
