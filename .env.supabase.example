# Configuration Supabase pour ng-PokedEC
# Copier ce fichier et le renommer en .env.supabase
# NE PAS COMMITER ce fichier avec vos vraies credentials !

# ============================================
# Connexion Base de Données
# ============================================
# Trouvez ces informations dans Supabase Dashboard > Settings > Database
SUPABASE_DB_HOST=db.xxx.supabase.co
SUPABASE_DB_PASSWORD=votre_mot_de_passe_supabase
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PORT=5432

# ============================================
# API REST
# ============================================
# Trouvez ces informations dans Supabase Dashboard > Settings > API
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# Storage (pour les images)
# ============================================
SUPABASE_STORAGE_BUCKET=pokemon-images

# ============================================
# Configuration de Synchronisation
# ============================================
# Fréquence de synchronisation (en minutes)
SYNC_INTERVAL=60

# Tables à exclure de la synchronisation (séparées par des virgules)
SYNC_EXCLUDE_TABLES=_migrations,logs

# ============================================
# Monitoring
# ============================================
# Webhook pour notifications (optionnel)
WEBHOOK_URL=https://hooks.slack.com/services/xxx
WEBHOOK_ON_FAILOVER=true
WEBHOOK_ON_SYNC_ERROR=true
